---
import Layout from '../layouts/MainLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SitemapList from '../components/SitemapList.astro';
import sitemapJson from '../assets/sitemap.json';

const breadcrumbItems = [{ title: 'Главная', href: '/' }, { title: 'Карта сайта' }];
---

<Layout title="Карта сайта - ЗАО «КМ-Про»"
  description="На странице Карта сайта размещен перечень опубликованных на нашем ресурсе страниц для удобства в навигации ⭐⭐⭐⭐⭐ Звоните 📞 +375 (29) 178-70-18"
  ogSiteName="Сайт компании ЗАО «КМ-про»"
  ogUrl="https://stellazhi.by/sitemap"
  ogTitle="Карта сайта - ЗАО «КМ-Про»"
  ogDescription="На странице Карта сайта размещен перечень опубликованных на нашем ресурсе страниц для удобства в навигации ⭐⭐⭐⭐⭐ Звоните 📞 +375 (29) 178-70-18"
  ogImage="https://stellazhi.by/images/stellazhi.webp"
  ogLocality="ru_BY"
  canonicalUrl="https://stellazhi.by/sitemap"
  customMetas={[
    {
      name: 'keywords',
      content: 'Карта сайта - ЗАО «КМ-Про»',
    },
  ]}
>

  <Breadcrumbs items={breadcrumbItems} />

  <div class="max-w-7xl mx-auto py-8">
    <div class="bg-white rounded-lg shadow-md p-8">
      <h1 class="text-2xl font-bold mb-6">Карта сайта</h1>

      <div class="prose max-w-none">
        <SitemapList items={sitemapJson} />
      </div>
    </div>
  </div>
</Layout>
